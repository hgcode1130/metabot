{
  "feishuBots": [
    {
      "name": "research-manager",
      "description": "Single user-facing research manager bot that coordinates hidden workers",
      "specialties": ["planning", "delegation", "research-management", "review", "summary"],
      "groupNoMention": true,
      "feishuAppId": "cli_manager_example",
      "feishuAppSecret": "manager-secret-example",
      "defaultWorkingDirectory": "/home/user/research-project",
      "manager": {
        "enabled": true,
        "workers": ["worker-literature", "worker-code", "worker-analysis"],
        "maxConcurrentWorkerTasks": 4
      },
      "persistentExecutor": {
        "enabled": true,
        "idleTimeoutMs": 3600000,
        "maxConcurrent": 4
      }
    },
    {
      "name": "project-beta",
      "description": "Backend API development agent for Project Beta",
      "specialties": ["backend", "api", "database"],
      "feishuAppId": "cli_yyy",
      "feishuAppSecret": "secret2",
      "defaultWorkingDirectory": "/home/user/project-beta",
      "maxTurns": 30,
      "maxBudgetUsd": 0.5
    },
    {
      "name": "project-gamma",
      "description": "Kimi-powered agent (uses your Moonshot subscription)",
      "engine": "kimi",
      "feishuAppId": "cli_zzz",
      "feishuAppSecret": "secret3",
      "defaultWorkingDirectory": "/home/user/project-gamma",
      "kimi": {
        "model": "kimi-latest",
        "thinking": true
      }
    },
    {
      "name": "project-delta",
      "description": "Codex-powered agent (uses Codex CLI)",
      "engine": "codex",
      "feishuAppId": "cli_codex",
      "feishuAppSecret": "secret4",
      "defaultWorkingDirectory": "/home/user/project-delta",
      "codex": {
        "model": "gpt-5.4-codex",
        "approvalPolicy": "never",
        "sandbox": "workspace-write"
      }
    }
  ],
  "webBots": [
    {
      "name": "worker-literature",
      "description": "Hidden worker for literature review, novelty checks, prior-art search, and citation/source synthesis",
      "specialties": ["literature", "novelty", "prior-art", "citation", "research", "summarization"],
      "defaultWorkingDirectory": "/home/user/research-project",
      "persistentExecutor": {
        "enabled": true,
        "idleTimeoutMs": 3600000,
        "maxConcurrent": 3
      }
    },
    {
      "name": "worker-code",
      "description": "Hidden worker for code implementation, experiment execution, debugging, tests, and reproducibility checks",
      "specialties": ["coding", "experiments", "debugging", "testing", "training", "reproducibility"],
      "defaultWorkingDirectory": "/home/user/research-project",
      "persistentExecutor": {
        "enabled": true,
        "idleTimeoutMs": 3600000,
        "maxConcurrent": 3
      }
    },
    {
      "name": "worker-analysis",
      "description": "Hidden worker for result analysis, independent review/audit, claims, paper writing, and rebuttal support",
      "specialties": ["analysis", "review", "audit", "claims", "paper-writing", "rebuttal", "experiments"],
      "defaultWorkingDirectory": "/home/user/research-project",
      "persistentExecutor": {
        "enabled": true,
        "idleTimeoutMs": 3600000,
        "maxConcurrent": 3
      }
    }
  ],
  "telegramBots": [
    {
      "name": "tg-project",
      "description": "General purpose project assistant via Telegram",
      "telegramBotToken": "123456:ABC-DEF...",
      "defaultWorkingDirectory": "/home/user/project"
    }
  ],
  "wechatBots": [
    {
      "name": "wechat-assistant",
      "description": "WeChat AI assistant via iLink",
      "defaultWorkingDirectory": "/home/user/project"
    }
  ],
  "peers": [
    {
      "name": "alice",
      "url": "http://localhost:9200",
      "secret": "alice-api-secret"
    },
    {
      "name": "remote-team",
      "url": "http://remote-server:9100",
      "secret": "remote-api-secret"
    }
  ]
}
